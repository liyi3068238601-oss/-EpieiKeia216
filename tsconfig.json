{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["packages/contracts/src/**/*.ts", "packages/character/src/**/*.ts", "packages/context/src/**/*.ts", "packages/adapters/zcode/src/**/*.ts", "packages/application/**/*.ts", "packages/config/src/**/*.ts", "packages/secrets/src/**/*.ts", "packages/storage/events/src/**/*.ts", "migrations/*.ts"],
  "exclude": ["dist", "node_modules"]
}
