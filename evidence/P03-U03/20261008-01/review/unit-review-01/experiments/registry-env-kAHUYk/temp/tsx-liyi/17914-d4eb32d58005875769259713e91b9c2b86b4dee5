OAC3C,KAAK,WAAW,OAAO,GAAG,EAC1B,KAAK,oBAAsB,SAAS,YACtC,CAEQ,OACN,IACA,MACM,CACN,MAAM,SAAW,KAAK,eAAe,IAAI,GAAG,EAC5C,GAAI,UAAY,SAAS,oBAAsB,MAAM,oBAAqB,OAC1E,KAAK,eAAe,IAAI,IAAK,CAC3B,eAAgB,MAAM,eACtB,oBAAqB,MAAM,mBAC7B,CAAC,CACH,CAEQ,iBACN,IACA,MACM,CACN,MAAM,OAAS,KAAK,WAAW,IAAI,GAAG,EACtC,GACE,QACA,OAAO,sBAAwB,MAAM,qBACrC,OAAO,iBAAmB,MAAM,eAChC,CACA,KAAK,QAAQ,IAAK,MAAM,CAC1B,CACA,KAAK,OAAO,IAAK,KAAK,CACxB,CAEQ,MACN,OAOA,WAC2B,CAC3B,MAAM,aAAe,kBAAkB,OAAO,YAAY,EAC1D,MAAO,CACL,KAAM,QACN,MAAO,CACL,GAAI,eAAiB,KAAO,CAAC,EAAI,CAAE,YAAa,EAChD,WACA,eAAgB,OAAO,eACvB,oBAAqB,OAAO,oBAC5B,MAAO,OAAO,MACd,eAAgB,OAAO,cACzB,CACF,CACF,CACF","names":["parsed"],"ignoreList":[],"sources":["E:\\Xiadie\\Xiadie\\.runtime\\P01\\desktop-source\\packages\\shared\\src\\zcode-protocol-v4\\wire-assembler.ts"],"sourcesContent":["/* eslint-disable max-lines -- physical assembly 的 ordinal、预算、校验与释放必须保持单一原子状态机。 */\n// V4 incremental physical assembler：ownership 过滤后逐片接纳，只在\n// checksum/UTF-8/JSON/schema 全部通过后产出一个 logical frame。\nimport { z } from \"zod\";\nimport { PROTOCOL_V4_LIMITS } from \"./core.js\";\nimport { crc32WireBytes, decodeWireBase64 } from \"./wire-binary.js\";\nimport { measureTopicNotificationEnvelopeBytes } from \"./wire-codec.js\";\nimport type { TopicFrameDeliveryKind, TopicWireFrameCandidate } from \"./wire.js\";\nimport { WIRE_FAULT_INVALID_PAYLOAD } from \"./wire-fault.js\";\n\nexport interface TopicWireAssemblyFault {\n  /** 缺失/伪值本身也必须成为 owned typed fault，此时不能伪造用途。 */\n  deliveryKind?: TopicFrameDeliveryKind;\n  reasonCode: string;\n  logicalFrameId: string;\n  logicalFrameOrdinal: number;\n  topic: string;\n  subscriptionId: string;\n}\n\nexport type TopicWireAssemblyEvent<F> =\n  | { kind: \"complete\"; frame: F; deliveryKind: TopicFrameDeliveryKind }\n  | { kind: \"fault\"; fault: TopicWireAssemblyFault };\n\nexport interface TopicWireFrameAssemblerOptions {\n  maxAssemblyBytes?: number;\n  maxFragments?: number;\n  maxConcurrentAssemblies?: number;\n  maxStagedDecodedBytes?: