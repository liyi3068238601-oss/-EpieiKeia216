{"code":"import{z}from\"zod\";const WORKFLOW_WORKSPACE_LIMITS={maxNodes:2e3,maxOpLength:32,maxArgs:16,maxErrorMessageLength:2e3,resultMaxBytes:32*1024};const workflowRunWorkspaceNodeKindSchema=z.enum([\"world-read\",\"world-run\"]);const workflowRunWorkspaceNodeStatusSchema=z.enum([\"running\",\"completed\",\"failed\"]);const workflowRunWorkspaceNodeErrorSchema=z.object({code:z.string().min(1).max(64),message:z.string().max(WORKFLOW_WORKSPACE_LIMITS.maxErrorMessageLength)}).strict();const workflowRunWorkspaceNodeSummarySchema=z.object({resultBytes:z.number().int().nonnegative(),resultCount:z.number().int().nonnegative().optional(),exitCode:z.number().int().optional(),stdoutBytes:z.number().int().nonnegative().optional(),stderrBytes:z.number().int().nonnegative().optional()}).strict();const workflowRunWorkspaceNodeSchema=z.object({siteId:z.string().min(1).max(64),ordinal:z.number().int().nonnegative(),kind:workflowRunWorkspaceNodeKindSchema,op:z.string().min(1).max(WORKFLOW_WORKSPACE_LIMITS.maxOpLength).optional(),args:z.array(z.unknown()).max(WORKFLOW_WORKSPACE_LIMITS.maxArgs).optional(),inputTruncated:z.literal(true).optional(),status:workflowRunWorkspaceNodeStatusSchema,error:workflowRunWorkspaceNodeErrorSchema.optional(),summary:workflowRunWorkspaceNodeSummarySchema.optional(),createdAt:z.number().int().nonnegative(),updatedAt:z.number().int().nonnegative()}).strict();const v4ConversationWorkflowRunWorkspaceParamsSchema=z.object({sessionId:z.string().min(1),runId:z.string().min(1)}).strict();const v4ConversationWorkflowRunWorkspaceResultSchema=z.object({nodes:z.array(workflowRunWorkspaceNodeSchema).max(WORKFLOW_WORKSPACE_LIMITS.maxNodes),truncated:z.boolean().optional()}).strict();const v4ConversationWorkflowRunNodeResultParamsSchema=z.object({sessionId:z.string().min(1),runId:z.string().min(1),siteId:z.string().min(1).max(64),ordinal:z.number().int().nonnegative(),maxBytes:z.number().int().positive().max(WORKFLOW_WORKSPACE_LIMITS.resultMaxBytes).optional()}).strict();const v4ConversationWorkflowRunNodeResultResultSchema=z.object({status:workflowRunWorkspaceNodeStatusSchema,result:z.unknown().optional(),error:workflowRunWorkspaceNodeErrorSchema.optional(),truncated:z.boolean(),totalBytes:z.number().int().nonnegative()}).strict();export{WORKFLOW_WORKSPACE_LIMITS,v4ConversationWorkflowRunNodeResultParamsSchema,v4ConversationWorkflowRunNodeResultResultSchema,v4ConversationWorkflowRunWorkspaceParamsSchema,v4ConversationWorkflowRunWorkspaceResultSchema,workflowRunWorkspaceNodeErrorSchema,workflowRunWorkspaceNodeKindSchema,workflowRunWorkspaceNodeSchema,workflowRunWorkspaceNodeStatusSchema,workflowRunWorkspaceNodeSummarySchema};\n","warnings":[],"map":{"version":3,"mappings":"AAgBA,OAAS,MAAS,MAGX,MAAM,0BAA4B,CAEvC,SAAU,IAEV,YAAa,GAEb,QAAS,GAET,sBAAuB,IAEvB,eAAgB,GAAK,IACvB,EAEO,MAAM,mCAAqC,EAAE,KAAK,CAAC,aAAc,WAAW,CAAC,EAI7E,MAAM,qCAAuC,EAAE,KAAK,CAAC,UAAW,YAAa,QAAQ,CAAC,EAItF,MAAM,oCAAsC,EAChD,OAAO,CACN,KAAM,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,EAAE,EAC9B,QAAS,EAAE,OAAO,EAAE,IAAI,0BAA0B,qBAAqB,CACzE,CAAC,EACA,OAAO,EAQH,MAAM,sCAAwC,EAClD,OAAO,CACN,YAAa,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EAC1C,YAAa,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EAAE,SAAS,EACrD,SAAU,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EACpC,YAAa,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EAAE,SAAS,EACrD,YAAa,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EAAE,SAAS,CACvD,CAAC,EACA,OAAO,EAOH,MAAM,+BAAiC,EAC3C,OAAO,CACN,OAAQ,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,EAAE,EAChC,QAAS,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EACtC,KAAM,mCACN,GAAI,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,0BAA0B,WAAW,EAAE,SAAS,EAC1E,KAAM,EAAE,MAAM,EAAE,QAAQ,CAAC,EAAE,IAAI,0BAA0B,OAAO,EAAE,SAAS,EAC3E,eAAgB,EAAE,QAAQ,IAAI,EAAE,SAAS,EACzC,OAAQ,qCACR,MAAO,oCAAoC,SAAS,EACpD,QAAS,sCAAsC,SAAS,EAExD,UAAW,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EACxC,UAAW,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,CAC1C,CAAC,EACA,OAAO,EAIH,MAAM,+CAAiD,EAC3D,OAAO,CACN,UAAW,EAAE,OAAO,EAAE,IAAI,CAAC,EAC3B,MAAO,EAAE,OAAO,EAAE,IAAI,CAAC,CACzB,CAAC,EACA,OAAO,EAKH,MAAM,+CAAiD,EAC3D,OAAO,CAEN,MAAO,EAAE,MAAM,8BAA8B,EAAE,IAAI,0BAA0B,QAAQ,EAErF,UAAW,EAAE,QAAQ,EAAE,SAAS,CAClC,CAAC,EACA,OAAO,EASH,MAAM,gDAAkD,EAC5D,OAAO,CACN,UAAW,EAAE,OAAO,EAAE,IAAI,CAAC,EAC3B,MAAO,EAAE,OAAO,EAAE,IAAI,CAAC,EACvB,OAAQ,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,EAAE,EAChC,QAAS,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EAEtC,SAAU,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EAAE,IAAI,0BAA0B,cAAc,EAAE,SAAS,CAC/F,CAAC,EACA,OAAO,EAKH,MAAM,gDAAkD,EAC5D,OAAO,CACN,OAAQ,qCAER,OAAQ,EAAE,QAAQ,EAAE,SAAS,EAC7B,MAAO,oCAAoC,SAAS,EACpD,UAAW,EAAE,QAAQ,EAErB,WAAY,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,CAC3C,CAAC,EACA,OAAO","names":[],"ignoreList":[],"sources":["E:\\Xiadie\\Xiadie\\.runtime\\P01\\desktop-source\\packages\\shared\\src\\zcode-protocol-v4\\workflow-workspace.ts"],"sourcesContent":["// ============================================================\n// 工作区 transcript 的协议词汇表\n// ============================================================\n// 一个 run 的 `files.*` / `git.*` / `world.run` 调用，在侧板上以工具卡片的形式回放。\n// 权威在 journal 的 `dwf_node` 行（`kind ∈ {world-read, world-run}`）：`input_json`\n// （迁移 0030）给出 op 与实参，`result_json` 给出正文。\n//\n// 两条 v4 查询，照用户面产物的 ①/③ 拆法：\n//   Workspace  轻行清单（op / args / 状态 / 摘要 / 时刻），**不带正文**；\n//              活投影的 `lastEventSequence` 抬升时重查\n//   NodeResult 一个节点的正文，按 maxBytes 保形有界化；展开时才取，按 tab 缓存\n//\n// 分层：正文永远不进清单；清单上的「多大 / 退出码 / 几条」由存储层用 SQLite 的 JSON 函数\n// 在库内算出。与 workflowRunEvents 同族：只读、无状态、超时重发安全，刻意不是 v4 command，\n// 不带 atSeq / atLogEpoch（读的是 journal，没有陈旧可防）。新方法天然偏斜安全。\n\nimport { z } from \"zod\";\n\n/** 工作区 transcript 的展示上界。数字即契约。 */\nexport const WORKFLOW_WORKSPACE_LIMITS = {\n  /** 一次清单最多多少行；超界由网关截尾并置 `truncated`。 */\n  maxNodes: 2000,\n  /** `op` 名的长度（`git-changed-files` 是最长的那个）。 */\n  maxOpLength: 32,\n  /** 实参个数（引擎侧截断后 ≤ 8；未截断的原值按 facade 签名 ≤ 3）。 */\n  maxArgs: 16,\n  /** 失败信息的展示长度；超长由宿主切尾。 */\n  maxErrorMessageLength: 2000,\n  /** 正文一次最多读回多少字节（截断而不是拒绝——这是审计面，不是脚本的取数面）。 */\n  resultMaxBytes: 32 * 1024,\n} as const;\n\nexport const workflowRunWorkspaceNodeKindSchema = z.enum([\"world-read\", \"world-run\"]);\nexport type WorkflowRunWorkspaceNodeKind = z.infer<typeof workflowRunWorkspaceNodeKindSchema>;\n\n/** journal 行的状态（`NodeRecordStatus` 的线上镜像）。 */\nexport const workflowRunWorkspaceNodeStatusSchema = z.enum([\"running\", \"completed\", \"failed\"]);\nexport type WorkflowRunWorkspaceNodeStatus = z.infer<typeof workflowRunWorkspaceNodeStatusSchema>;\n\n/** 结构化失败：journal `error_json` 的 code + message（其余字段不出协议）。 */\nexport const workflowRunWorkspaceNodeErrorSchema = z\n  .object({\n    code: z.string().min(1).max(64),\n    message: z.string().max(WORKFLOW_WORKSPACE_LIMITS.maxErrorMessageLength),\n  })\n  .strict();\nexport type WorkflowRunWorkspaceNodeError = z.infer<typeof workflowRunWorkspaceNodeErrorSchema>;\n\n/**\n * 清单上一行的摘要：不解正文就能报的几个数。哪个在场取决于 op——数组正文（glob / grep /\n * changedFiles）有 `resultCount`，`world.run` 有 `exitCode` 与两路输出的字节数，字符串正文\n * 只有 `resultBytes`。\n */\nexport const workflowRunWorkspaceNodeSummarySchema = z\n  .object({\n    resultBytes: z.number().int().nonnegative(),\n    resultCount: z.number().int().nonnegative().optional(),\n    exitCode: z.number().int().optional(),\n    stdoutBytes: z.number().int().nonnegative().optional(),\n    stderrBytes: z.number().int().nonnegative().optional(),\n  })\n  .strict();\nexport type WorkflowRunWorkspaceNodeSummary = z.infer<typeof workflowRunWorkspaceNodeSummarySchema>;\n\n/**\n * 工作区 transcript 的一行。`op` / `args` 来自 `input_json`，升级前的历史行两者缺席\n * （UI 退回静态图上的步标签）；`inputTruncated` 表示 args 是逐项字符串预览而不是原值。\n */\nexport const workflowRunWorkspaceNodeSchema = z\n  .object({\n    siteId: z.string().min(1).max(64),\n    ordinal: z.number().int().nonnegative(),\n    kind: workflowRunWorkspaceNodeKindSchema,\n    op: z.string().min(1).max(WORKFLOW_WORKSPACE_LIMITS.maxOpLength).optional(),\n    args: z.array(z.unknown()).max(WORKFLOW_WORKSPACE_LIMITS.maxArgs).optional(),\n    inputTruncated: z.literal(true).optional(),\n    status: workflowRunWorkspaceNodeStatusSchema,\n    error: workflowRunWorkspaceNodeErrorSchema.optional(),\n    summary: workflowRunWorkspaceNodeSummarySchema.optional(),\n    /** journal 行的建立 / 最近更新时刻（epoch 毫秒）；二者之差就是这一步的耗时。 */\n    createdAt: z.number().int().nonnegative(),\n    updatedAt: z.number().int().nonnegative(),\n  })\n  .strict();\nexport type WorkflowRunWorkspaceNode = z.infer<typeof workflowRunWorkspaceNodeSchema>;\n\n// ── v4 query ①：workflowRunWorkspace（轻行清单）──\nexport const v4ConversationWorkflowRunWorkspaceParamsSchema = z\n  .object({\n    sessionId: z.string().min(1),\n    runId: z.string().min(1),\n  })\n  .strict();\nexport type V4ConversationWorkflowRunWorkspaceParams = z.infer<\n  typeof v4ConversationWorkflowRunWorkspaceParamsSchema\n>;\n\nexport const v4ConversationWorkflowRunWorkspaceResultSchema = z\n  .object({\n    /** 按落库先后（journal 行 id 升序 = 引擎准入顺序）。 */\n    nodes: z.array(workflowRunWorkspaceNodeSchema).max(WORKFLOW_WORKSPACE_LIMITS.maxNodes),\n    /** 清单超过 maxNodes 被截尾。 */\n    truncated: z.boolean().optional(),\n  })\n  .strict();\nexport type V4ConversationWorkflowRunWorkspaceResult = z.infer<\n  typeof v4ConversationWorkflowRunWorkspaceResultSchema\n>;\n\n// ── v4 query ②：workflowRunNodeResult（一个节点的正文）──\n// 授权在 CLI 侧（端口实现）：sessionId 必须是该 run 的 parentSessionId，否则与「无此节点」\n// 同一个答案。正文按 maxBytes **保形**有界化：字符串切尾、数组去尾、run 的 stdout / stderr\n// 各自切尾——一张卡片要的是「跑了什么、前几百行是什么」，不是脚本那种全有或全无。\nexport const v4ConversationWorkflowRunNodeResultParamsSchema = z\n  .object({\n    sessionId: z.string().min(1),\n    runId: z.string().min(1),\n    siteId: z.string().min(1).max(64),\n    ordinal: z.number().int().nonnegative(),\n    /** 缺省与上限都是 resultMaxBytes；网关钳制。 */\n    maxBytes: z.number().int().positive().max(WORKFLOW_WORKSPACE_LIMITS.resultMaxBytes).optional(),\n  })\n  .strict();\nexport type V4ConversationWorkflowRunNodeResultParams = z.infer<\n  typeof v4ConversationWorkflowRunNodeResultParamsSchema\n>;\n\nexport const v4ConversationWorkflowRunNodeResultResultSchema = z\n  .object({\n    status: workflowRunWorkspaceNodeStatusSchema,\n    /** 有界化后的正文；running 行与 failed 行缺席。 */\n    result: z.unknown().optional(),\n    error: workflowRunWorkspaceNodeErrorSchema.optional(),\n    truncated: z.boolean(),\n    /** 截断前的序列化字节数。 */\n    totalBytes: z.number().int().nonnegative(),\n  })\n  .strict();\nexport type V4ConversationWorkflowRunNodeResultResult = z.infer<\n  typeof v4ConversationWorkflowRunNodeResultResultSchema\n>;\n"]}}