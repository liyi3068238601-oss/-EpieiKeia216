as: readonly ConversationDelta[],\n  profile: DeliveryProfile,\n): ConversationDelta[] {\n  return deltas.filter((delta) => {\n    if (delta.op === \"row.delta\") return profile.streamPaths[delta.path];\n    return true;\n  });\n}\n"]}}