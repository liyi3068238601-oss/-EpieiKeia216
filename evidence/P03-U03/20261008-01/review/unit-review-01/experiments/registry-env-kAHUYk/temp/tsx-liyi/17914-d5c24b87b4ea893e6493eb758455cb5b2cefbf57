bol 回 undefined，对循环引用抛错——\n    // 两种情况都退到 String(value)，绝不把值整段丢掉。\n    const text = JSON.stringify(value, null, 2);\n    return text === undefined ? String(value) : text;\n  } catch {\n    return String(value);\n  }\n}\n"]}}