{"code":"import{z}from\"zod\";import{toolCallCreateWorkflowDisplaySchema}from\"./create-workflow-display.js\";import{WORKFLOW_RUNS_LIMITS}from\"./workflow-runs.js\";const workflowNotificationMetaSchema=z.discriminatedUnion(\"kind\",[z.object({kind:z.literal(\"terminal\"),status:z.enum([\"completed\",\"errored\",\"stopped\"]),stopReason:z.enum([\"user\",\"model\",\"provider\",\"interrupted\",\"superseded\"]).optional(),summary:z.string().min(1).max(500),result:z.string().max(4e3).optional(),resultForm:z.enum([\"prose\",\"json\"]).optional(),resultTruncated:z.literal(true).optional(),error:z.string().max(2e3).optional(),reports:z.object({count:z.number().int().nonnegative(),shown:z.number().int().nonnegative(),preview:z.array(z.string().max(500)).max(8)}).optional(),artifacts:z.array(z.object({id:z.string().min(1).max(64),kind:z.enum([\"file\",\"markdown\",\"chart\",\"table\",\"metrics\",\"board\"]),title:z.string().max(120).optional(),version:z.number().int().positive(),contentType:z.string().max(255).optional(),primary:z.literal(true).optional(),description:z.string().max(500).optional()})).max(8).optional(),artifactsTruncated:z.literal(true).optional(),durationMs:z.number().nonnegative().optional()}),z.object({kind:z.literal(\"escalation\"),qid:z.string().min(1),actor:z.string().min(1),question:z.string().min(1).max(4e3),context:z.string().max(4e3).optional(),askedAt:z.number().optional()}),z.object({kind:z.literal(\"stall\"),sinceMs:z.number().int().nonnegative(),reason:z.string().max(64).optional(),cap:z.number().int().nonnegative().optional()})]);const backgroundResultOriginMetaSchema=z.object({backgroundSource:z.enum([\"bash\",\"subagent\",\"workflow\"]),workId:z.string().min(1),title:z.string().min(1),workflowNotification:workflowNotificationMetaSchema.optional()});const workflowSubagentModelTextSchema=z.string().min(1).max(WORKFLOW_RUNS_LIMITS.maxSubagentModelLength);const workflowSettingsAmendMetaSchema=z.object({predecessorRunId:z.string().min(1).max(128).optional(),subagentModel:z.object({from:workflowSubagentModelTextSchema.optional(),to:workflowSubagentModelTextSchema.optional()}).optional(),maxConcurrency:z.object({from:z.number().int().positive().optional(),to:z.number().int().positive().optional()}).optional(),ceiling:z.number().int().positive().optional()});const workflowLaunchMetaSchema=z.object({runId:z.string().min(1).max(128),toolCallId:z.string().min(1).max(128),name:z.string().min(1).max(200).optional(),scope:z.enum([\"project\",\"global\"]).optional(),path:z.string().min(1).max(1024).optional(),args:z.record(z.string(),z.unknown()).refine(value=>JSON.stringify(value).length<=4096,{message:\"workflowLaunch.args JSON must be \\u2264 4096 bytes\"}).optional(),description:z.string().max(500).optional(),display:toolCallCreateWorkflowDisplaySchema.optional().catch(void 0),script:z.string().max(256e3).optional(),amend:workflowSettingsAmendMetaSchema.optional()});export{backgroundResultOriginMetaSchema,workflowLaunchMetaSchema,workflowNotificationMetaSchema,workflowSettingsAmendMetaSchema};\n","warnings":[],"map":{"version":3,"mappings":"AAOA,OAAS,MAAS,MAClB,OAAS,wCAA2C,+BACpD,OAAS,yBAA4B,qBAM9B,MAAM,+BAAiC,EAAE,mBAAmB,OAAQ,CACzE,EAAE,OAAO,CACP,KAAM,EAAE,QAAQ,UAAU,EAC1B,OAAQ,EAAE,KAAK,CAAC,YAAa,UAAW,SAAS,CAAC,EAElD,WAAY,EAAE,KAAK,CAAC,OAAQ,QAAS,WAAY,cAAe,YAAY,CAAC,EAAE,SAAS,EACxF,QAAS,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,GAAG,EAClC,OAAQ,EAAE,OAAO,EAAE,IAAI,GAAI,EAAE,SAAS,EACtC,WAAY,EAAE,KAAK,CAAC,QAAS,MAAM,CAAC,EAAE,SAAS,EAC/C,gBAAiB,EAAE,QAAQ,IAAI,EAAE,SAAS,EAC1C,MAAO,EAAE,OAAO,EAAE,IAAI,GAAI,EAAE,SAAS,EACrC,QAAS,EACN,OAAO,CACN,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EACpC,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,YAAY,EACpC,QAAS,EAAE,MAAM,EAAE,OAAO,EAAE,IAAI,GAAG,CAAC,EAAE,IAAI,CAAC,CAC7C,CAAC,EACA,SAAS,EASZ,UAAW,EACR,MACC,EAAE,OAAO,CACP,GAAI,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,EAAE,EAC5B,KAAM,EAAE,KAAK,CAAC,OAAQ,WAAY,QAAS,QAAS,UAAW,OAAO,CAAC,EACvE,MAAO,EAAE,OAAO,EAAE,IAAI,GAAG,EAAE,SAAS,EACpC,QAAS,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,E