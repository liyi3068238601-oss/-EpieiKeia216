  "findings": [
    {
      "id": "F1",
      "claim": "SDK is an owned subprocess using newline-delimited JSON-RPC over stdio.",
      "sources": [
        "protocol-readme",
        "client-launch",
        "server-entry"
      ]
    },
    {
      "id": "F2",
      "claim": "initialize validates/configures the provider/model route and returns serverInfo; the server lazily creates a session for an unknown sessionId on the first session/prompt. The request map has no cancel, session-close, approval/respond, version negotiation, or resume method; generic transport supports server requests, but the SDK server never sends one.",
      "sources": [
        "protocol-readme",
        "protocol-types",
        "server-entry",
        "core-resume-api"
      ]
    },
    {
      "id": "F3",
      "claim": "messageId is a queued-message receipt and idle is status, not business success or per-prompt turn completion.",
      "sources": [
        "protocol-readme",
        "client-api",
        "server-tests"
      ]
    },
    {
      "id": "F4",
      "claim": "Client abort abandons a local pending request; closing the client tears down the whole child runtime.",
      "sources": [
        "protocol-transport",
        "client-implementation",
        "transport-tests",
        "dispose-tests"
      ]
    },
    {
      "id": "F5",
      "claim": "The default package-manifest resolver checks SDK client/DSH version equality and supports explicit dshHome; passing explicit dshBin bypasses that version check.",
      "sources": [
        "client-launch",
        "client-types",
        "machine-dsh-package"
      ]
    },
    {
      "id": "F6",
      "claim": "SDK app inherits broad base tools; the generic transport can carry server requests, but the SDK server does not send approval requests. Approval docs say ask without an answerer fails closed.",
      "sources": [
        "base-patch",
        "approval-readme",
        "protocol-readme"
      ]
    },
    {
      "id": "F7",
      "claim": "The root build profile selects the client artifact environment, accepts only its default or official profile, and does not define an SDK profile; the default build runs native-system/lib/web stages. Root postinstall changes Git hook configuration.",
      "sources": [
        "build-script",
        "postinstall-script"
      ]
    },
    {
      "id": "F8",
      "claim": "Shared Web adapter differs architecturally and is UNLICENSED with no root LICENSE; source reuse requires permission.",
      "sources": [
        "adapter-package",
        "adapter-readme"
      ]
    }
  ],
  "recommended_u02": {
    "status": "NOT_RUN",
    "gateway_port": 7877,
    "model_route": "[基元]deepseek-flash",
